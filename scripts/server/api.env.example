# /etc/roofops/api.env — produced by bootstrap.sh on first run, then edited
# in-place. Owned root:roofops, mode 0640. NEVER committed to git.

NODE_ENV=production
PORT=3000
HOST=127.0.0.1
LOG_LEVEL=info

DATABASE_URL=postgresql://roofops:CHANGE-ME@127.0.0.1:5432/roofops
REDIS_URL=redis://127.0.0.1:6379

JWT_SECRET=CHANGE-ME-AT-LEAST-32-CHARS
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000
PASSWORD_RESET_TTL_SECONDS=3600

APP_WEB_URL=https://app.example.com
CORS_ORIGINS=https://app.example.com

SENTRY_DSN=
OTEL_SERVICE_NAME=roofops-api

EMAIL_FROM=no-reply@example.com
