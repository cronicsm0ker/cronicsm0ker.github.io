# Server
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# Database
DATABASE_URL=postgresql://roofops:roofops@localhost:5432/roofops_dev

# Redis (Phase 1+; not used in Phase 0 but reserved here)
REDIS_URL=redis://localhost:6379

# Auth
JWT_SECRET=change-me-to-a-long-random-secret-of-at-least-32-chars
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000
PASSWORD_RESET_TTL_SECONDS=3600

# CORS — comma-separated origins for the web/mobile dev hosts
CORS_ORIGINS=http://localhost:5173,http://localhost:8081

# Observability
SENTRY_DSN=
OTEL_SERVICE_NAME=roofops-api

# Email — stubbed in Phase 0; reset URLs print to the log
EMAIL_FROM=no-reply@roofops.local
APP_WEB_URL=http://localhost:5173

# S3-compatible storage for assets (Phase 2+). Leave blank to disable
# uploads in dev. The same vars work for Backblaze B2, Cloudflare R2,
# AWS S3, or a local MinIO. Set S3_FORCE_PATH_STYLE=true for MinIO.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
S3_PUBLIC_URL=

# Anthropic Claude — used by AI proposal generator (Phase 2+).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
