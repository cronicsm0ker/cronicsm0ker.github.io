// RoofOps database schema.
//
// Phase 0 scope: identity, auth tokens, multi-tenancy primitives.
// Every tenant-scoped table MUST carry `org_id` and queries MUST filter on it.
// `contacts` exists as the multi-tenancy canary so the access pattern is
// exercised end-to-end before Phase 1 lands real lead/contact features.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = []
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  ADMIN
  MEMBER
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  memberships         Membership[]
  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  ownedLeads          Lead[]              @relation("LeadOwner")
  activities          Activity[]          @relation("ActivityActor")
  sentMessages        Message[]           @relation("MessageSender")
  auditLogs           AuditLog[]          @relation("AuditActor")
  uploadedAssets      Asset[]             @relation("AssetUploader")
  createdProposals    Proposal[]          @relation("ProposalCreator")

  @@map("users")
}

model Org {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  memberships        Membership[]
  contacts           Contact[]
  leads              Lead[]
  activities         Activity[]
  threads            MessageThread[]
  messages           Message[]
  channelCredentials ChannelCredential[]
  auditLogs          AuditLog[]
  priceBookItems     PriceBookItem[]
  assets             Asset[]
  measurements       Measurement[]
  proposals          Proposal[]
  proposalVersions   ProposalVersion[]

  @@map("orgs")
}

model Membership {
  userId    String   @map("user_id") @db.Uuid
  orgId     String   @map("org_id") @db.Uuid
  role      Role
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  org  Org  @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@id([userId, orgId])
  @@index([orgId])
  @@map("memberships")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

// ---- Phase 1: leads, messaging, audit ----

model Contact {
  id          String    @id @default(uuid()) @db.Uuid
  orgId       String    @map("org_id") @db.Uuid
  name        String
  email       String?
  phone       String?
  // Normalized lookup fields for dedup (lowercase email, E.164 phone).
  emailNorm   String?   @map("email_norm")
  phoneNorm   String?   @map("phone_norm")
  notes       String?
  preferredChannel MessageChannel? @map("preferred_channel")
  optedOutAt  DateTime? @map("opted_out_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  org      Org              @relation(fields: [orgId], references: [id], onDelete: Cascade)
  leads    Lead[]
  threads  MessageThread[]
  activities Activity[]

  @@index([orgId, id])
  @@index([orgId, emailNorm])
  @@index([orgId, phoneNorm])
  @@map("contacts")
}

enum LeadStage {
  NEW
  CONTACTED
  QUALIFIED
  ESTIMATING
  PROPOSAL_SENT
  WON
  LOST
  DORMANT
}

enum LeadSource {
  WEB_FORM
  META_ADS
  GOOGLE_ADS
  TIKTOK_ADS
  WHATSAPP
  SMS
  IMESSAGE
  EMAIL
  TELEGRAM
  PHONE
  MANUAL
  CSV_IMPORT
  REFERRAL
  OTHER
}

model Lead {
  id              String     @id @default(uuid()) @db.Uuid
  orgId           String     @map("org_id") @db.Uuid
  contactId       String     @map("contact_id") @db.Uuid
  ownerId         String?    @map("owner_id") @db.Uuid
  stage           LeadStage  @default(NEW)
  source          LeadSource
  sourceMeta      Json?      @map("source_meta")
  title           String?
  notes           String?
  firstRespondedAt DateTime? @map("first_responded_at")
  slaBreachedAt   DateTime?  @map("sla_breached_at")
  wonAt           DateTime?  @map("won_at")
  lostAt          DateTime?  @map("lost_at")
  lostReason      String?    @map("lost_reason")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")
  deletedAt       DateTime?  @map("deleted_at")

  org        Org        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  contact    Contact    @relation(fields: [contactId], references: [id], onDelete: Cascade)
  owner      User?      @relation("LeadOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  activities Activity[]

  @@index([orgId, stage, createdAt])
  @@index([orgId, ownerId, stage])
  @@index([orgId, contactId])
  @@index([orgId, source])
  @@map("leads")
}

enum ActivityKind {
  LEAD_CREATED
  LEAD_STAGE_CHANGED
  LEAD_ASSIGNED
  LEAD_NOTE
  MESSAGE_INBOUND
  MESSAGE_OUTBOUND
  CALL_LOGGED
  PROPOSAL_SENT
  PROPOSAL_VIEWED
  PROPOSAL_ACCEPTED
  CONTACT_MERGED
  CHANNEL_OPTED_OUT
}

model Activity {
  id        String       @id @default(uuid()) @db.Uuid
  orgId     String       @map("org_id") @db.Uuid
  kind      ActivityKind
  contactId String?      @map("contact_id") @db.Uuid
  leadId    String?      @map("lead_id") @db.Uuid
  threadId  String?      @map("thread_id") @db.Uuid
  messageId String?      @map("message_id") @db.Uuid
  actorId   String?      @map("actor_id") @db.Uuid
  payload   Json?
  createdAt DateTime     @default(now()) @map("created_at")

  org     Org             @relation(fields: [orgId], references: [id], onDelete: Cascade)
  contact Contact?        @relation(fields: [contactId], references: [id], onDelete: SetNull)
  lead    Lead?           @relation(fields: [leadId], references: [id], onDelete: SetNull)
  thread  MessageThread?  @relation(fields: [threadId], references: [id], onDelete: SetNull)
  message Message?        @relation(fields: [messageId], references: [id], onDelete: SetNull)
  actor   User?           @relation("ActivityActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([orgId, leadId, createdAt])
  @@index([orgId, contactId, createdAt])
  @@index([orgId, kind, createdAt])
  @@map("activities")
}

enum MessageChannel {
  WHATSAPP
  IMESSAGE
  SMS
  EMAIL
  TELEGRAM
  WEB_FORM
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageStatus {
  PENDING
  SENT
  DELIVERED
  READ
  FAILED
}

model MessageThread {
  id              String         @id @default(uuid()) @db.Uuid
  orgId           String         @map("org_id") @db.Uuid
  contactId       String         @map("contact_id") @db.Uuid
  leadId          String?        @map("lead_id") @db.Uuid
  channel         MessageChannel
  externalId      String?        @map("external_id")
  lastMessageAt   DateTime?      @map("last_message_at")
  unreadCount     Int            @default(0) @map("unread_count")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  org      Org       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  contact  Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  messages Message[]
  activities Activity[]

  @@unique([orgId, channel, externalId])
  @@index([orgId, contactId, channel])
  @@index([orgId, lastMessageAt])
  @@map("message_threads")
}

model Message {
  id          String           @id @default(uuid()) @db.Uuid
  orgId       String           @map("org_id") @db.Uuid
  threadId    String           @map("thread_id") @db.Uuid
  direction   MessageDirection
  channel     MessageChannel
  body        String
  externalId  String?          @map("external_id")
  status      MessageStatus    @default(PENDING)
  sentBy      String?          @map("sent_by") @db.Uuid
  attachments Json?
  errorMessage String?         @map("error_message")
  createdAt   DateTime         @default(now()) @map("created_at")

  org    Org           @relation(fields: [orgId], references: [id], onDelete: Cascade)
  thread MessageThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  sender User?         @relation("MessageSender", fields: [sentBy], references: [id], onDelete: SetNull)
  activities Activity[]

  @@unique([orgId, channel, externalId])
  @@index([orgId, threadId, createdAt])
  @@map("messages")
}

model ChannelCredential {
  id          String         @id @default(uuid()) @db.Uuid
  orgId       String         @map("org_id") @db.Uuid
  channel     MessageChannel
  label       String
  // Provider-specific config stored as JSON (API tokens, phone numbers, etc.).
  // In production these should be encrypted at rest via pgcrypto / KMS.
  config      Json
  webhookToken String?       @unique @map("webhook_token")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")
  disabledAt  DateTime?      @map("disabled_at")

  org Org @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, channel, label])
  @@index([orgId, channel])
  @@map("channel_credentials")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  orgId      String   @map("org_id") @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  action     String
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  before     Json?
  after      Json?
  requestId  String?  @map("request_id")
  ip         String?
  createdAt  DateTime @default(now()) @map("created_at")

  org   Org   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  actor User? @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([orgId, createdAt])
  @@index([orgId, entityType, entityId])
  @@index([orgId, actorId, createdAt])
  @@map("audit_logs")
}

// ---- Phase 2: price book, assets, measurements, proposals ----

enum PriceBookKind {
  MATERIAL
  LABOR
  FEE
}

model PriceBookItem {
  id              String         @id @default(uuid()) @db.Uuid
  orgId           String         @map("org_id") @db.Uuid
  kind            PriceBookKind
  name            String
  description     String?
  unit            String
  // Money in cents (BigInt). Default markup in basis points (3000 = 30%).
  unitCostCents   BigInt         @map("unit_cost_cents")
  markupBps       Int            @default(3000) @map("markup_bps")
  // Decimal as int basis points: 1000 = 10% waste. Materials waste defaults
  // vary by category; the org can override per item.
  wasteFactorBps  Int            @default(1000) @map("waste_factor_bps")
  sku             String?
  archivedAt      DateTime?      @map("archived_at")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  org Org @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, name])
  @@index([orgId, kind])
  @@index([orgId, archivedAt])
  @@map("price_book_items")
}

enum AssetKind {
  PHOTO
  BLUEPRINT
  DOCUMENT
  PROPOSAL_PDF
  SIGNED_CONTRACT
  THUMBNAIL
  OTHER
}

enum AssetStatus {
  PENDING
  READY
  REJECTED
}

enum AssetOwnerType {
  CONTACT
  LEAD
  PROPOSAL
}

model Asset {
  id           String          @id @default(uuid()) @db.Uuid
  orgId        String          @map("org_id") @db.Uuid
  ownerType    AssetOwnerType  @map("owner_type")
  ownerId      String          @map("owner_id") @db.Uuid
  kind         AssetKind
  mimeType     String          @map("mime_type")
  sizeBytes    BigInt          @map("size_bytes")
  s3Key        String          @unique @map("s3_key")
  thumbnailKey String?         @unique @map("thumbnail_key")
  // SHA-256 of the file contents. Used to detect tampering on signed
  // contracts and to dedup repeated uploads.
  contentHash  String          @map("content_hash")
  status       AssetStatus     @default(PENDING)
  uploadedBy   String?         @map("uploaded_by") @db.Uuid
  meta         Json?
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")

  org      Org           @relation(fields: [orgId], references: [id], onDelete: Cascade)
  uploader User?         @relation("AssetUploader", fields: [uploadedBy], references: [id], onDelete: SetNull)
  measurements Measurement[]

  @@index([orgId, ownerType, ownerId])
  @@index([orgId, kind])
  @@index([orgId, contentHash])
  @@map("assets")
}

enum MeasurementMethod {
  BLUEPRINT
  MANUAL_POLYGON
  SOLAR_API
  EAGLEVIEW
  MANUAL
  FIELD_PHOTO
}

enum MeasurementUnit {
  SQFT
  LF
  EACH
  COUNT
  SQUARES // roofing squares = 100 sq ft
}

model Measurement {
  id          String             @id @default(uuid()) @db.Uuid
  orgId       String             @map("org_id") @db.Uuid
  leadId      String?            @map("lead_id") @db.Uuid
  assetId     String?            @map("asset_id") @db.Uuid
  method      MeasurementMethod
  label       String
  value       Decimal            @db.Decimal(14, 2)
  unit        MeasurementUnit
  // Confidence 0-100. 100 = vendor-certified (EagleView), human-measured
  // blueprints land 70-90, AI extraction lands 40-80.
  confidence  Int
  notes       String?
  payload     Json?
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")

  org   Org    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  asset Asset? @relation(fields: [assetId], references: [id], onDelete: SetNull)

  @@index([orgId, leadId, createdAt])
  @@index([orgId, method])
  @@map("measurements")
}

enum ProposalStatus {
  DRAFT
  SENT
  VIEWED
  ACCEPTED
  REJECTED
  EXPIRED
  WITHDRAWN
}

model Proposal {
  id                 String         @id @default(uuid()) @db.Uuid
  orgId              String         @map("org_id") @db.Uuid
  leadId             String         @map("lead_id") @db.Uuid
  contactId          String         @map("contact_id") @db.Uuid
  status             ProposalStatus @default(DRAFT)
  // Public token hash for the customer portal signed link.
  publicTokenHash    String         @unique @map("public_token_hash")
  currentVersionId   String?        @map("current_version_id") @db.Uuid
  generatedByAi      Boolean        @default(false) @map("generated_by_ai")
  aiConfidence       Int?           @map("ai_confidence")
  sentAt             DateTime?      @map("sent_at")
  viewedAt           DateTime?      @map("viewed_at")
  acceptedAt         DateTime?      @map("accepted_at")
  rejectedAt         DateTime?      @map("rejected_at")
  expiresAt          DateTime?      @map("expires_at")
  rejectionReason    String?        @map("rejection_reason")
  createdBy          String?        @map("created_by") @db.Uuid
  createdAt          DateTime       @default(now()) @map("created_at")
  updatedAt          DateTime       @updatedAt @map("updated_at")

  org      Org               @relation(fields: [orgId], references: [id], onDelete: Cascade)
  creator  User?             @relation("ProposalCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  versions ProposalVersion[]

  @@index([orgId, leadId])
  @@index([orgId, status, createdAt])
  @@index([orgId, contactId])
  @@map("proposals")
}

model ProposalVersion {
  id           String   @id @default(uuid()) @db.Uuid
  orgId        String   @map("org_id") @db.Uuid
  proposalId   String   @map("proposal_id") @db.Uuid
  version      Int
  // Frozen snapshot: lineItems, totals, terms, deposit, contact info,
  // measurements referenced. We never mutate a version after publish; new
  // edits create a new version.
  snapshot     Json
  totalCents   BigInt   @map("total_cents")
  depositCents BigInt   @map("deposit_cents")
  taxRateBps   Int      @map("tax_rate_bps")
  createdBy    String?  @map("created_by") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")

  org      Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  proposal Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  @@unique([proposalId, version])
  @@index([orgId, proposalId, version])
  @@map("proposal_versions")
}
